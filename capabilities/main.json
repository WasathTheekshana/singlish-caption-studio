{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Least privilege: only our own commands and event listening.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-projects",
    "allow-inspect-project",
    "allow-list-fonts",
    "allow-get-settings",
    "allow-save-settings",
    "allow-setup-state",
    "allow-complete-setup",
    "allow-key-status",
    "allow-save-api-key",
    "allow-delete-api-key",
    "allow-get-glossary",
    "allow-save-glossary",
    "allow-restore-backup",
    "allow-get-usage",
    "allow-clear-usage",
    "allow-set-price",
    "allow-app-info",
    "allow-open-link",
    "allow-check-update",
    "allow-install-update",
    "allow-get-update-settings",
    "allow-set-auto-update-check",
    "allow-start-caption"
  ]
}
