{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Singlish Caption Studio",
  "version": "0.4.0",
  "identifier": "app.singlishcaptionstudio",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Singlish Caption Studio",
        "width": 520,
        "height": 780,
        "minWidth": 440,
        "minHeight": 580,
        "maxWidth": 760,
        "maxHeight": 1100,
        "maximizable": false,
        "fullscreen": false,
        "theme": "Light",
        "center": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Wasath",
    "copyright": "Copyright (c) 2026 Wasath. MIT License.",
    "shortDescription": "Sinhala and English auto-captions for CapCut",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMjYxNDcxN0IyQ0NGOEEKUldTS3p5eDdjUlFtTHd0R3BOTmlVdEJmNk1ZQ0V0Uk9pSmZXajh4NnAvTjhBcUV4T25NY1NmN08K",
      "endpoints": [
        "https://github.com/WasathTheekshana/singlish-caption-studio/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
